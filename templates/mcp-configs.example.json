{
  "mcpServers": {
    "codegraph": {
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    },
    "chrome-devtools-isolated": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--userDataDir=/Users/yourname/.gemini/chrome-test-profile"
      ],
      "env": {
        "NPM_CONFIG_LOGLEVEL": "error"
      }
    }
  }
}
